# unit-platform-auth — SSO adapter configuration
# Secrets are injected at runtime from a managed secret manager (ADR-AUTH-04).
# This file documents the required variables; do NOT commit real secrets.

# OIDC discovery endpoint of the corporate IdP (issuer URL).
OIDC_ISSUER_URL=https://idp.example.com

# Registered client id and secret for this application.
OIDC_CLIENT_ID=vacation-request-app
OIDC_CLIENT_SECRET=change-me-injected-at-runtime

# Callback URL registered with the IdP (must be https in production).
OIDC_REDIRECT_URI=https://vacation.example.com/auth/callback

# Session token signing key (>= 256 bits). Injected from secret manager.
SESSION_SIGNING_KEY=change-me-at-least-32-bytes-of-entropy

# HTTP port (optional; defaults to 3000).
PORT=3000
